{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/b87/scheck/docs/report-schema.json",
  "title": "scheck run envelope",
  "description": "SPEC.md §7.4, schema 1.6. Development schema; compatibility starts at the first GitHub release.",
  "type": "object",
  "required": ["schema_version", "host", "run", "facts", "observations", "assessments", "findings"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "host": {
      "type": "object",
      "required": ["id", "hostname", "platform", "os", "kernel", "transport", "canary", "elevation"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "hostname": { "type": "string" },
        "platform": { "enum": ["linux", "macos"] },
        "os": { "type": "string" },
        "kernel": { "type": "string" },
        "transport": { "enum": ["local", "ssh", "fixture"] },
        "remote_shell": { "type": "string" },
        "canary": { "enum": ["ok", "fail", "n/a"] },
        "elevation": { "enum": ["none", "sudo", "root"] }
      }
    },
    "run": {
      "type": "object",
      "required": ["started", "duration_ms", "status", "profile", "mode", "assessment", "provider", "model", "effort", "native", "limits", "usage", "context_sources", "persisted", "warnings", "scheck_version"],
      "additionalProperties": false,
      "properties": {
        "started": { "type": "string", "format": "date-time" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "status": { "enum": ["complete", "incomplete"] },
        "profile": { "enum": ["baseline", "hardened"] },
        "mode": { "enum": ["facts", "agent", "single-pass"] },
        "assessment": { "enum": ["none", "rules", "agent"] },
        "provider": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "effort": { "type": ["string", "null"], "enum": ["low", "medium", "high", "max", null] },
        "native": { "type": ["object", "null"], "additionalProperties": false,
          "properties": { "tool_calling": { "type": "boolean" }, "parallel_tool_calls": { "type": "boolean" }, "prompt_caching": { "type": "boolean" }, "reasoning": { "type": "boolean" } } },
        "limits": { "type": ["object", "null"], "additionalProperties": false,
          "properties": { "max_context": { "type": "integer" }, "local": { "type": "boolean" } } },
        "prompt_version": { "type": "string" },
        "agent": {
          "type": "object", "additionalProperties": false,
          "required": ["iterations", "checks", "reported", "ended"],
          "properties": {
            "iterations": { "type": "integer", "minimum": 0 },
            "checks": { "type": "integer", "minimum": 0 },
            "reported": { "type": "integer", "minimum": 0 },
            "ended": { "type": "string" },
            "text": { "type": "string" },
            "ruled_out": {
              "type": "array",
              "description": "SPEC.md §5.7: ids the model checked and closed with verdict: ruled_out. Never a finding, never graded.",
              "items": {
                "type": "object",
                "required": ["id", "note"],
                "additionalProperties": false,
                "properties": {
                  "id": { "type": "string" },
                  "note": { "type": "string" },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["check", "excerpt"],
                      "additionalProperties": false,
                      "properties": {
                        "check": { "type": "string" },
                        "observation": { "type": "string", "minLength": 1 },
                        "excerpt": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "usage": {
          "type": "object",
          "required": ["input", "output", "cache_read", "cache_write", "cost_usd"],
          "properties": {
            "input": { "type": "integer" },
            "output": { "type": "integer" },
            "cache_read": { "type": "integer" },
            "cache_write": { "type": "integer" },
            "cost_usd": { "type": ["number", "null"] }
          }
        },
        "context_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "kind", "sha256", "bytes", "truncated"],
            "additionalProperties": false,
            "properties": {
              "source": { "type": "string" },
              "kind": { "enum": ["config", "implicit", "file", "note", "target"] },
              "sha256": { "type": "string" },
              "bytes": { "type": "integer", "minimum": 0 },
              "truncated": { "type": "boolean" },
              "unresolved": { "type": "boolean" }
            }
          }
        },
        "persisted": { "type": ["string", "null"] },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "scheck_version": { "type": "string" }
      }
    },
    "facts": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
      "additionalProperties": {
        "type": "object",
        "required": ["observation", "status", "attempted", "summary", "duration_ms"],
        "additionalProperties": false,
        "properties": {
          "observation": { "type": "string", "minLength": 1 },
          "status": { "enum": ["ok", "unavailable", "denied"] },
          "reason": { "type": "string" },
          "summary": { "type": "string" },
          "reason_code": { "enum": ["unknown_check", "invalid_params", "path_denied", "metadata_unavailable", "requires_elevation", "command_missing", "check_timeout", "run_timeout", "canceled", "exec_error", "sudo_refused", "exit_error", "parse_error", "extract_error"] },
          "attempted": { "type": "boolean" },
          "evidence": {
            "type": "object", "additionalProperties": false,
            "required": ["stdout", "stderr"],
            "properties": { "stdout": { "type": "string" }, "stderr": { "type": "string" } }
          },
          "parsed": {},
          "truncated": { "type": "boolean" },
          "redactions": { "type": "integer", "minimum": 0 },
          "elevated": { "type": "boolean" },
          "duration_ms": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "status",
          "attempted",
          "summary",
          "duration_ms",
          "observation",
          "check",
          "occurrence"
        ],
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "ok",
              "unavailable",
              "denied"
            ]
          },
          "reason": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "reason_code": {
            "enum": [
              "unknown_check",
              "invalid_params",
              "path_denied",
              "metadata_unavailable",
              "requires_elevation",
              "command_missing",
              "check_timeout",
              "run_timeout",
              "canceled",
              "exec_error",
              "sudo_refused",
              "exit_error",
              "parse_error",
              "extract_error"
            ]
          },
          "attempted": {
            "type": "boolean"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stdout",
              "stderr"
            ],
            "properties": {
              "stdout": {
                "type": "string"
              },
              "stderr": {
                "type": "string"
              }
            }
          },
          "truncated": {
            "type": "boolean"
          },
          "redactions": {
            "type": "integer",
            "minimum": 0
          },
          "elevated": {
            "type": "boolean"
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "check": {
            "type": "string"
          },
          "ran_as": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "occurrence": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "assessments": {
      "type": "array",
      "description": "SPEC.md §7.5: one entry per selected posture rule. Not a finding; never sets the exit code.",
      "items": {
        "type": "object",
        "required": ["finding", "check", "status", "reason"],
        "additionalProperties": false,
        "properties": {
          "observation": { "type": "string", "minLength": 1 },
          "finding": { "type": "string" },
          "check": { "type": "string" },
          "status": { "enum": ["matched", "not_matched", "not_applicable", "not_assessed"] },
          "reason": { "type": "string" }
        }
      }
    },
    "findings": {
      "type": "array",
      "description": "SPEC.md §7.3. Phase 1 emits rule findings only (source: rule).",
      "items": {
        "type": "object",
        "required": ["id", "title", "category", "severity_base", "severity", "adjustments", "status", "source", "confidence", "platform", "evidence", "impact", "remediation"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "category": { "enum": ["remote-access", "network", "accounts", "privesc", "integrity", "updates", "persistence", "logging", "fs", "disk", "time", "governance", "custom"] },
          "severity_base": { "enum": ["critical", "high", "medium", "low", "info"] },
          "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
          "adjustments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["rule", "source", "delta"],
              "properties": {
                "rule": { "type": "string" },
                "source": { "type": "string" },
                "delta": { "type": "string" }
              }
            }
          },
          "status": { "enum": ["open", "accepted"] },
          "accepted_reason": { "type": "string" },
          "source": { "enum": ["rule", "model"] },
          "context_note": { "type": "string" },
          "service": {
            "type": "object", "additionalProperties": false,
            "required": ["port", "proto"],
            "properties": { "port": { "type": "integer", "minimum": 1, "maximum": 65535 }, "proto": { "enum": ["tcp", "udp"] } }
          },
          "custom": { "type": "boolean" },
          "confidence": { "enum": ["high", "medium", "low"] },
          "platform": { "type": "string" },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["check", "excerpt"],
              "additionalProperties": false,
              "properties": {
                "check": { "type": "string" },
                "observation": { "type": "string", "minLength": 1 },
                "excerpt": { "type": "string" }
              }
            }
          },
          "impact": { "type": "string" },
          "remediation": {
            "type": "object",
            "required": ["summary"],
            "additionalProperties": false,
            "properties": {
              "summary": { "type": "string" },
              "commands": { "type": "array", "items": { "type": "string" } },
              "caveat": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
