          "collected_at": "2026-10-07T07:12:03Z",
          "excerpt": "-rw-r--rw-:646:root:shadow",
          "kind": "observed",
          "observation": "accounts.shadow_meta#1",
          "principal": "deploy"
        }
      ],
      "exposure_finding": false,
      "id": "accounts.shadow_permissions_unexpected",
      "impact": "The hashed-password file is expected to be readable only by root (mode 0, 600, or 640 with group shadow). A different mode is a deviation worth explaining; it is not by itself evidence that an unauthorized user has read the file.",
      "key": {
        "asset": "host:ubuntu:22",
        "id": "accounts.shadow_permissions_unexpected",
        "subject": null
      },
      "not_checked": [],
      "remediation": {
        "caveat": "Match the distribution's own default rather than copying a mode from another system.",
        "commands": [
          "stat -c '%A %a %U:%G' /etc/shadow",
          "# Debian and Ubuntu: 640 root:shadow — Fedora and RHEL: 000 root:root"
        ],
        "summary": "Restore the mode this distribution ships."
      },
      "rule": {
        "kind": "single_fact",
        "reads": [
          "check:accounts.shadow_meta"
        ]
      },
      "severity": "high",
      "severity_base": "high",
      "status": "open",
      "subject": null,
      "title": "/etc/shadow has an unexpected mode",
      "why_here": []
    },
