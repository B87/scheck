        }
      ],
      "exposure_finding": false,
      "id": "accounts.empty_password",
      "impact": "The account has an empty password field and a shell that lets someone log in. Most Linux distributions accept an empty password for local logins by default (su, the console, a provider's serial console), so anyone or anything already running on this host can become this account without a credential, and become root if the account is root. If sshd or another network service accepts empty passwords, the account can be logged into remotely; an engagement judges sshd's case as accounts.empty_password_remote when it reads sshd's settings and listeners.",
      "key": {
        "asset": "host:ubuntu:22",
        "id": "accounts.empty_password",
        "subject": null
      },
      "not_checked": [],
      "remediation": {
        "caveat": "Find out what the account is for before you change it. Locking stops password logins only; with UsePAM no in sshd it also blocks SSH key logins for that account.",
        "commands": [
          "# who is it, and does anyone use it?",
          "sudo passwd -S \u003caccount\u003e",
          "last \u003caccount\u003e | head",
          "# nobody logs in with a password: lock it",
          "sudo passwd -l \u003caccount\u003e",
          "# a service account that should never log in: also",
          "sudo usermod -s /usr/sbin/nologin \u003caccount\u003e",
          "# a person who needs it: set one",
          "sudo passwd \u003caccount\u003e",
          "# confirm sshd refuses empty passwords (expect \"permitemptypasswords no\")",
          "sudo sshd -T | grep -i permitemptypasswords"
        ],
        "summary": "Lock the account, or set a password if a person really logs in with one."
      },
      "rule": {
        "kind": "single_fact",
        "reads": [
          "check:accounts.passwd_status",
          "check:accounts.passwd"
        ]
      },
      "severity": "high",
      "severity_base": "high",
      "status": "open",
      "subject": null,
      "title": "A local account with a login shell has no password",
      "why_here": [
