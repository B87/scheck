/etc/sudoers.d/scheck:# scheck elevated checks for ops on linux — generated from the compiled catalog.
/etc/sudoers.d/scheck:# Review, then install with: visudo -cf - < fragment && install -m 440 fragment /etc/sudoers.d/scheck
/etc/sudoers.d/scheck:# Every line grants exactly one read-only command with fixed flags; scheck runs them as `sudo -n -- ...`.
/etc/sudoers.d/scheck:Defaults:ops !requiretty
/etc/sudoers.d/scheck:ops ALL=(root) NOPASSWD: /usr/bin/cat /etc/sudoers  # privesc.sudoers
/etc/sudoers.d/scheck:ops ALL=(root) NOPASSWD: /usr/bin/find /root /home -xdev -maxdepth 4 -name node_modules -prune -o -name .git -prune -o -name .cache -prune -o -type d -not -perm -0011 -ls -o -type f -name id_rsa -ls -o -type l -name id_rsa -ls -o -type f -name id_ed25519 -ls -o -type l -name id_ed25519 -ls -o -type f -name id_ecdsa -ls -o -type l -name id_ecdsa -ls -o -type f -name id_dsa -ls -o -type l -name id_dsa -ls -o -type f -name id_ed25519_sk -ls -o -type l -name id_ed25519_sk -ls -o -type f -name id_ecdsa_sk -ls -o -type l -name id_ecdsa_sk -ls -o -type f -name credentials -ls -o -type l -name credentials -ls -o -type f -name credentials.db -ls -o -type l -name credentials.db -ls -o -type f -name application_default_credentials.json -ls -o -type l -name application_default_credentials.json -ls -o -type f -name access_tokens.db -ls -o -type l -name access_tokens.db -ls  # creds.home_files
/etc/sudoers.d/scheck:ops ALL=(root) NOPASSWD: /usr/bin/grep -rH . /etc/sudoers.d  # privesc.sudoers_d
/etc/sudoers.d/scheck:ops ALL=(root) NOPASSWD: /usr/bin/passwd -S -a  # accounts.passwd_status
/etc/sudoers.d/scheck:ops ALL=(root) NOPASSWD: /usr/bin/ss -tulpnH  # net.listeners
/etc/sudoers.d/scheck:ops ALL=(root) NOPASSWD: /usr/sbin/aa-status ""  # mac.aa_status
/etc/sudoers.d/scheck:ops ALL=(root) NOPASSWD: /usr/sbin/nft list ruleset  # fw.nft
/etc/sudoers.d/scheck:ops ALL=(root) NOPASSWD: /usr/sbin/ss -tulpnH  # net.listeners
/etc/sudoers.d/scheck:ops ALL=(root) NOPASSWD: /usr/sbin/sshd -T  # sshd.config
/etc/sudoers.d/scheck:ops ALL=(root) NOPASSWD: /usr/sbin/ufw status verbose  # fw.ufw
