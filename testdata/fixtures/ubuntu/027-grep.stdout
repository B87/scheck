/etc/crontab:# /etc/crontab: system-wide crontab
/etc/crontab:# Unlike any other crontab you don't have to run the `crontab'
/etc/crontab:# command to install the new version when you edit this file
/etc/crontab:# and files in /etc/cron.d. These files also have username fields,
/etc/crontab:# that none of the other crontabs do.
/etc/crontab:SHELL=/bin/sh
/etc/crontab:# You can also override PATH, but by default, newer versions inherit it from the environment
/etc/crontab:#PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
/etc/crontab:# Example of job definition:
/etc/crontab:# .---------------- minute (0 - 59)
/etc/crontab:# |  .------------- hour (0 - 23)
/etc/crontab:# |  |  .---------- day of month (1 - 31)
/etc/crontab:# |  |  |  .------- month (1 - 12) OR jan,feb,mar,apr ...
/etc/crontab:# |  |  |  |  .---- day of week (0 - 6) (Sunday=0 or 7) OR sun,mon,tue,wed,thu,fri,sat
/etc/crontab:# |  |  |  |  |
/etc/crontab:# *  *  *  *  * user-name command to be executed
/etc/crontab:17 *	* * *	root	cd / && run-parts --report /etc/cron.hourly
/etc/crontab:25 6	* * *	root	test -x /usr/sbin/anacron || { cd / && run-parts --report /etc/cron.daily; }
/etc/crontab:47 6	* * 7	root	test -x /usr/sbin/anacron || { cd / && run-parts --report /etc/cron.weekly; }
/etc/crontab:52 6	1 * *	root	test -x /usr/sbin/anacron || { cd / && run-parts --report /etc/cron.monthly; }
/etc/crontab:#
/etc/cron.d/e2scrub_all:30 3 * * 0 root test -e /run/systemd/system || SERVICE_MODE=1 /usr/lib/aarch64-linux-gnu/e2fsprogs/e2scrub_all_cron
/etc/cron.d/e2scrub_all:10 3 * * * root test -e /run/systemd/system || SERVICE_MODE=1 /sbin/e2scrub_all -A -r
/etc/cron.d/.placeholder:# DO NOT EDIT OR REMOVE
/etc/cron.d/.placeholder:# This file is a simple placeholder to keep dpkg from removing this directory
